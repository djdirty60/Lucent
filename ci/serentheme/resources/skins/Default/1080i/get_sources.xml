<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent theme for Seren - Scraping / searching for streams -->
<window type="dialog">
    <!-- colours: the Lucent skin's own (its colour theme) or Lucent's default glass colours -->
    <onload condition="!String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.focus,focus,home)</onload>
    <onload condition="!String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.onfocus,on_focus,home)</onload>
    <onload condition="!String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.glow,glow,home)</onload>
    <onload condition="String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.focus,FFFFFFFF,home)</onload>
    <onload condition="String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.onfocus,FF0B1119,home)</onload>
    <onload condition="String.IsEmpty(Skin.String(lucent.lite.checked))">SetProperty(lucent.seren.glow,66D6F0FF,home)</onload>
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- ============ Cinematic backdrop ============ -->
        <control type="group">
            <control type="image">
                <texture>lucent/white.png</texture>
                <colordiffuse>FF0B1119</colordiffuse>
            </control>
            <control type="image">
                <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
                <aspectratio>scale</aspectratio>
                <texture background="true">$INFO[Window().Property(item.art.fanart)]</texture>
                <animation effect="zoom" start="100" end="110" center="960,540" time="24000" tween="sine" easing="inout" reversible="false" condition="!Skin.HasSetting(lucent.lite)">Conditional</animation>
            </control>
            <control type="image">
                <width>1500</width>
                <texture>lucent/grad_left.png</texture>
                <colordiffuse>F50B1119</colordiffuse>
            </control>
            <control type="image">
                <top>440</top>
                <height>640</height>
                <texture>lucent/grad_bottom.png</texture>
                <colordiffuse>FF0B1119</colordiffuse>
            </control>
            <control type="image">
                <texture>lucent/vignette.png</texture>
                <colordiffuse>99000000</colordiffuse>
            </control>
        </control>

        <!-- ============ Logo / title ============ -->
        <control type="group">
            <animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
            <animation effect="slide" start="-60,0" end="0,0" time="400" delay="100" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" end="0" time="300">WindowClose</animation>
            <left>96</left>
            <top>96</top>
            <width>760</width>

            <control type="image">
                <width>560</width>
                <height>220</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <texture>$INFO[Window().Property(item.art.clearlogo)]</texture>
                <visible>!String.IsEmpty(Window().Property(item.art.clearlogo))</visible>
            </control>
            <control type="textbox">
                <top>100</top>
                <width>760</width>
                <height>120</height>
                <font>font37</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <label>[B]$INFO[Window().Property(item.info.tvshowtitle)][/B]</label>
                <visible>String.IsEmpty(Window().Property(item.art.clearlogo)) + !String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
            <control type="textbox">
                <top>100</top>
                <width>760</width>
                <height>120</height>
                <font>font37</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>bottom</aligny>
                <label>[B]$INFO[Window().Property(item.info.title)][/B]</label>
                <visible>String.IsEmpty(Window().Property(item.art.clearlogo)) + String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>

            <control type="label">
                <top>252</top>
                <width>760</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>FFDCE2E7</textcolor>
                <label>[B]S$INFO[Window().Property(item.info.season)] · E$INFO[Window().Property(item.info.episode)][/B]$INFO[Window().Property(item.info.title),   ,]</label>
                <visible>!String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
            <control type="label">
                <top>252</top>
                <width>760</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>FFDCE2E7</textcolor>
                <label>$INFO[Window().Property(item.info.year)]$INFO[Window().Property(item.info.mpaa),  ·  ,]</label>
                <visible>String.IsEmpty(Window().Property(item.info.season))</visible>
            </control>
        </control>

        <!-- ============ Notification before scraping starts ============ -->
        <control type="label">
            <left>96</left>
            <top>760</top>
            <width>1200</width>
            <height>40</height>
            <font>font12</font>
            <textcolor>FFBDC8D1</textcolor>
            <label>$INFO[Window().Property(notification_text)]</label>
            <visible>String.IsEqual(Window().Property(process_started),false)</visible>
        </control>

        <!-- ============ Glass progress card ============ -->
        <control type="group">
            <animation effect="fade" time="350" condition="String.IsEqual(Window().Property(process_started),true)">Conditional</animation>
            <animation effect="slide" start="0,60" end="0,0" time="400" tween="cubic" easing="out" condition="String.IsEqual(Window().Property(process_started),true)">Conditional</animation>
            <animation effect="fade" end="0" time="300">WindowClose</animation>
            <left>96</left>
            <top>604</top>
            <width>840</width>
            <height>404</height>
