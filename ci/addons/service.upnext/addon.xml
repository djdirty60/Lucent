<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- CI only: the texts and windows of the Up Next add-on (im85288, MoojMidge, GPL-2.0), without its service, so the skin's
     own Up Next windows can be opened and photographed -->
<addon id="service.upnext" name="UpNext" version="2.0.30" provider-name="im85288, MoojMidge">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Up Next (CI copy)</summary>
        <platform>all</platform>
    </extension>
</addon>
