<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.lucent" version="0.31.5" name="Lucent Video" provider-name="Claude">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context.py" args="source">
                <label>32130</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode)]</visible>
            </item>
            <item library="context.py" args="watched">
                <label>32131</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,episode)] + Integer.IsEqual(ListItem.PlayCount,0)</visible>
            </item>
            <item library="context.py" args="watched">
                <label>32132</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,episode)] + Integer.IsGreater(ListItem.PlayCount,0)</visible>
            </item>
            <item library="context.py" args="watchlist_add">
                <label>32133</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="watchlist_remove">
                <label>32134</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="trailer">
                <label>32135</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)] + !String.IsEmpty(ListItem.Trailer)</visible>
            </item>
            <item library="context.py" args="cast">
                <label>32136</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="similar">
                <label>32137</label>
                <visible>String.Contains(ListItem.Path,plugin.video.lucent/library) + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,tvshow)]</visible>
            </item>
            <item library="context.py" args="addwidget">
                <label>32175</label>
                <visible>ListItem.IsFolder + !ListItem.IsParentFolder + !Window.IsVisible(home) + System.HasAddon(skin.lucent) + !String.IsEmpty(Skin.String(nuvio.tab1.label)) + [String.StartsWith(ListItem.FolderPath,plugin://) | String.StartsWith(ListItem.Path,plugin://) | String.StartsWith(ListItem.FolderPath,videodb://) | String.StartsWith(ListItem.Path,videodb://) | String.StartsWith(ListItem.FolderPath,musicdb://) | String.StartsWith(ListItem.Path,musicdb://) | String.StartsWith(ListItem.FolderPath,library://) | String.StartsWith(ListItem.Path,library://) | String.StartsWith(ListItem.FolderPath,special://) | String.StartsWith(ListItem.Path,special://) | String.StartsWith(ListItem.FolderPath,addons://) | String.StartsWith(ListItem.Path,addons://) | String.StartsWith(ListItem.FolderPath,pvr://) | String.StartsWith(ListItem.Path,pvr://) | String.StartsWith(ListItem.FolderPath,sources://) | String.StartsWith(ListItem.Path,sources://)]</visible>
            </item>
            <item library="context.py" args="browseshow">
                <label>32176</label>
                <visible>String.IsEqual(ListItem.DBType,episode) + System.HasAddon(skin.lucent) + [!String.IsEmpty(ListItem.TvShowDBID) | [[String.StartsWith(ListItem.FileNameAndPath,plugin://) | String.StartsWith(ListItem.Path,plugin://)] + !String.StartsWith(ListItem.FileNameAndPath,plugin://plugin.video.seren/) + [!String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.Property(tmdb_id))]]]</visible>
            </item>
            <item library="context.py" args="browseeps">
                <label>32177</label>
                <visible>String.IsEqual(ListItem.DBType,episode) + System.HasAddon(skin.lucent) + [!String.IsEmpty(ListItem.TvShowDBID) | [[String.StartsWith(ListItem.FileNameAndPath,plugin://) | String.StartsWith(ListItem.Path,plugin://)] + !String.StartsWith(ListItem.FileNameAndPath,plugin://plugin.video.seren/) + [!String.IsEmpty(ListItem.UniqueID(tmdb)) | !String.IsEmpty(ListItem.Property(tmdb_id))]]] + !String.IsEmpty(ListItem.Season)</visible>
            </item>
            <item library="context.py" args="addlib">
                <label>32178</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + String.IsEmpty(ListItem.DBID) + [!String.IsEmpty(ListItem.Property(tmdb_id)) | !String.IsEmpty(ListItem.UniqueID(tmdb))] + String.IsEmpty(ListItem.Property(lucent_video)) + System.HasAddon(skin.lucent)</visible>
            </item>
            <item library="context.py" args="removelib">
                <label>32179</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library)]</visible>
            </item>
            <item library="context.py" args="skiplib">
                <label>32186</label>
                <visible>[String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library) | String.Contains(ListItem.FileNameAndPath,plugin.video.lucent/library)]</visible>
            </item>
            <item library="context.py" args="rate">
                <label>32180</label>
                <visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)] + [String.Contains(ListItem.Path,plugin.video.lucent/library) | String.Contains(ListItem.FolderPath,plugin.video.lucent/library)]</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Movies and series for Lucent, with AIOStreams and Trakt</summary>
        <summary lang="nl_NL">Films en series voor Lucent, met AIOStreams en Trakt</summary>
        <description lang="en_GB">Browse with TMDB, play through your own AIOStreams address and keep your progress on Trakt. Works without Seren.</description>
        <description lang="nl_NL">Bladeren met TMDB, afspelen via je eigen AIOStreams-adres en je voortgang bijhouden op Trakt. Werkt zonder Seren.</description>
        <platform>all</platform>
        <license>MIT</license>
        <news>0.31.5: Marking many watched titles in the Kodi library (the first time your whole history comes in) now happens while the screensaver is on, so the screen no longer jumps. Without a screensaver it waits for 15 minutes without a key press.
0.31.4: A small card at the top right shows how far marking your watched titles is. Any key hides it and works as usual.
0.31.3: Many library changes at once are written a few at a time and pause when you press a key.
0.31.2: Format check: clips now start on Android boxes that first switch to HDR or another refresh rate.
0.31.1: Only show what you can watch already now also counts for your watchlist and own lists.
0.31.0: Faster lists, tidier menus, and a format check and Extra step in the setup assistant.
0.30.0: Library and lists: one window with ticks shows where a film or series is.</news>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
