                    <label>$INFO[Window.Property(b.where)]</label>
                    <visible>!String.IsEmpty(Window.Property(b.where)) + !!String.IsEmpty(Window.Property(cinema))</visible>
                </control>
            </control>
            <!-- what OK does after waking up -->
            <control type="grouplist">
                <left>1000</left><top>986</top><width>824</width><height>56</height>
                <orientation>horizontal</orientation><align>right</align>
                <visible>!String.IsEmpty(Window.Property(askopen)) + !String.IsEmpty(Window.Property(b.open))</visible>
                <control type="button">
                    <width>auto</width><height>56</height><font>font13_bold</font><textoffsetx>28</textoffsetx><aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
                    <texturefocus border="24" colordiffuse="30FFFFFF">pill.png</texturefocus><texturenofocus border="24" colordiffuse="30FFFFFF">pill.png</texturenofocus>
                    <label>$ADDON[screensaver.lucent 30034]</label>
                </control>
            </control>
        </control>
        <!-- small clock -->
        <control type="label">
            <left>1400</left><top>50</top><width>420</width><height>50</height>
            <font>font14</font><textcolor>CCFFFFFF</textcolor><align>right</align>
            <label>$INFO[System.Time]</label>
            <visible>!String.IsEmpty(Window.Property(showclock)) + String.IsEmpty(Window.Property(bigclock))</visible>
        </control>
        <!-- big clock with the weather -->
        <control type="group">
            <visible>!String.IsEmpty(Window.Property(bigclock))</visible>
            <control type="image">
                <left>1020</left><top>0</top><width>900</width><height>420</height>
                <texture>shade_corner.png</texture>
            </control>
            <control type="label">
                <left>1020</left><top>70</top><width>800</width><height>100</height>
                <font>font_hero</font><textcolor>FFFFFFFF</textcolor><align>right</align>
                <label>$INFO[System.Time(hh:mm)]</label>
                <animation effect="zoom" start="170" end="170" center="1820,120" time="0" condition="true">Conditional</animation>
            </control>
            <control type="label">
                <left>1020</left><top>200</top><width>800</width><height>44</height>
                <font>font14</font><textcolor>DDFFFFFF</textcolor><align>right</align>
                <label>$INFO[System.Date]</label>
            </control>
            <control type="label">
                <left>1020</left><top>252</top><width>800</width><height>44</height>
                <font>font14</font><textcolor>FFFFFFFF</textcolor><align>right</align>
                <label>$INFO[Window.Property(weather)]</label>
                <visible>!String.IsEmpty(Window.Property(weather))</visible>
            </control>
        </control>
        <!-- night mode -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>black.png</texture><colordiffuse>A0FFFFFF</colordiffuse>
            <visible>!String.IsEmpty(Window.Property(night))</visible>
            <animation effect="fade" time="2000">VisibleChange</animation>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>black.png</texture>
            <visible>!String.IsEmpty(Window.Property(black))</visible>
            <animation effect="fade" time="4000">VisibleChange</animation>
        </control>
    </controls>
</window>
