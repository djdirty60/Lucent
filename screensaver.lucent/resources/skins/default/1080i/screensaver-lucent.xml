<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent screensaver 1.2.0: key art that zooms slowly; two slots (a, b) take turns. Optional: cinema style (plot and
     score), Continue watching (progress bar), new episodes (tag), big clock with weather, night mode (darker, then black). -->
<window>
    <defaultcontrol always="true">1</defaultcontrol>
    <backgroundcolor>FF000000</backgroundcolor>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>black.png</texture>
        </control>
