                </control>
                <control type="image" id="7603">
                    <width>132</width>
                    <height>51</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$VAR[NuvioFlagImg_vcodec]</texture>
                    <visible>String.IsEqual(VideoPlayer.VideoCodec,hevc) | String.IsEqual(VideoPlayer.VideoCodec,av1) | String.IsEqual(VideoPlayer.VideoCodec,h264) | String.IsEqual(VideoPlayer.VideoCodec,vp9)</visible>
                </control>
                <control type="image" id="7604">
                    <width>132</width>
                    <height>51</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$VAR[NuvioFlagImg_atmos]</texture>
                    <visible>[String.IsEqual(VideoPlayer.AudioCodec,truehd_atmos) | String.IsEqual(VideoPlayer.AudioCodec,eac3_ddp_atmos)]</visible>
                </control>
                <control type="image" id="7605">
                    <width>132</width>
                    <height>51</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$VAR[NuvioFlagImg_acodec]</texture>
                    <visible>String.StartsWith(VideoPlayer.AudioCodec,dtshd_ma_x) | String.StartsWith(VideoPlayer.AudioCodec,truehd) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma) | String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra) | String.StartsWith(VideoPlayer.AudioCodec,dts) | String.StartsWith(VideoPlayer.AudioCodec,eac3) | String.IsEqual(VideoPlayer.AudioCodec,ac3) | [String.StartsWith(VideoPlayer.AudioCodec,aac) | String.StartsWith(VideoPlayer.AudioCodec,he_aac)] | String.IsEqual(VideoPlayer.AudioCodec,flac) | String.IsEqual(VideoPlayer.AudioCodec,opus) | String.StartsWith(VideoPlayer.AudioCodec,pcm) | String.IsEqual(VideoPlayer.AudioCodec,mp3)</visible>
                </control>
                <control type="image" id="7606">
                    <width>132</width>
                    <height>51</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$VAR[NuvioFlagImg_ch]</texture>
                    <visible>String.IsEqual(VideoPlayer.AudioChannels,8) | String.IsEqual(VideoPlayer.AudioChannels,7) | String.IsEqual(VideoPlayer.AudioChannels,6) | String.IsEqual(VideoPlayer.AudioChannels,2) | String.IsEqual(VideoPlayer.AudioChannels,1)</visible>
                </control>
                </control>
                <control type="label" id="7508">
                    <width>1100</width>
                    <height>20</height>
                    <label></label>
                </control>
                <control type="label" id="7509">
                    <width>1100</width>
                    <height>36</height>
                    <font>font12</font>
                    <textcolor>text3</textcolor>
                    <label>$INFO[VideoPlayer.Director,$LOCALIZE[20339]: ,]</label>
                    <visible>!String.IsEmpty(VideoPlayer.Director)</visible>
                </control>
                <control type="label" id="7510">
                    <width>1100</width>
                    <height>36</height>
                    <font>font12</font>
                    <textcolor>text3</textcolor>
                    <label>$INFO[VideoPlayer.Studio,$LOCALIZE[572]: ,]$INFO[VideoPlayer.mpaa,   ·   ,]</label>
                    <visible>!String.IsEmpty(VideoPlayer.Studio) | !String.IsEmpty(VideoPlayer.mpaa)</visible>
                </control>
            </control>
        </control>

