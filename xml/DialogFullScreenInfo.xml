<?xml version="1.0" encoding="UTF-8"?>
<window>
    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>360</height>
            <texture>grad_top.png</texture>
            <colordiffuse>E6000000</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>560</top>
            <width>1920</width>
            <height>520</height>
            <texture>grad_bottom.png</texture>
            <colordiffuse>F2000000</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1200</width>
            <height>1080</height>
            <texture>grad_left.png</texture>
            <colordiffuse>B3000000</colordiffuse>
        </control>
        <!-- Logo / title -->
        <control type="group">
            <left>96</left>
            <top>56</top>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>440</width>
                <height>150</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <texture background="true">$VAR[PlayerLogo]</texture>
            </control>
            <control type="label">
                <left>0</left>
                <top>40</top>
                <width>1300</width>
                <height>70</height>
                <font>font45</font>
                <label>$VAR[PlayerTitle]</label>
                <visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>160</top>
                <width>1300</width>
                <height>40</height>
                <font>font13_bold</font>
                <textcolor>text2</textcolor>
                <label>$VAR[PlayerSubtitle]</label>
            </control>
        </control>
        <control type="label">
            <right>96</right>
            <top>56</top>
            <width>500</width>
            <height>44</height>
            <align>right</align>
            <font>font_clock</font>
            <label>$INFO[System.Time]</label>
        </control>
        <control type="label">
            <right>96</right>
            <top>100</top>
            <width>500</width>
            <height>36</height>
            <align>right</align>
            <font>font10</font>
            <textcolor>text3</textcolor>
            <label>$LOCALIZE[31047] $INFO[Player.FinishTime]</label>
            <visible>Player.HasDuration</visible>
        </control>
        <control type="textbox">
            <left>96</left>
            <top>620</top>
            <width>1000</width>
            <height>200</height>
            <font>font_body</font>
            <textcolor>text2</textcolor>
            <label>$INFO[VideoPlayer.Plot]</label>
        </control>
        <control type="group">
            <left>96</left>
            <top>936</top>
            <width>1728</width>
            <control type="label">
                <left>0</left>
                <top>-56</top>
                <width>400</width>
                <height>40</height>
                <font>font13_bold</font>
                <label>$INFO[Player.Time]</label>
            </control>
            <control type="label">
                <right>0</right>
                <top>-56</top>
                <width>600</width>
                <height>40</height>
                <align>right</align>
                <font>font13</font>
                <textcolor>text3</textcolor>
                <label>-$INFO[Player.TimeRemaining]   /   $INFO[Player.Duration]</label>
            </control>
            <control type="progress">
                <left>0</left>
                <top>0</top>
                <width>1728</width>
                <height>6</height>
                <info>Player.ProgressCache</info>
                <texturebg border="3" colordiffuse="26FFFFFF">pill6.png</texturebg>
                <midtexture border="3" colordiffuse="40FFFFFF">pill6.png</midtexture>
            </control>
            <control type="progress">
                <left>0</left>
                <top>0</top>
                <width>1728</width>
                <height>6</height>
                <info>Player.Progress</info>
                <texturebg/>
                <midtexture border="3" colordiffuse="text">pill6.png</midtexture>
            </control>
        </control>
    </controls>
</window>
