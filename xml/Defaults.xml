<?xml version="1.0" encoding="UTF-8"?>
<!-- Default looks for every control type (Nuvio Arc V2 cinematic glass) -->
<includes>
    <default type="label">
        <font>font12</font>
        <textcolor>text</textcolor>
        <shadowcolor>transparent</shadowcolor>
        <aligny>center</aligny>
        <height>40</height>
    </default>
    <default type="fadelabel">
        <font>font12</font>
        <textcolor>text</textcolor>
        <height>40</height>
    </default>
    <default type="textbox">
        <font>font_body</font>
        <textcolor>text3</textcolor>
    </default>
    <default type="button">
        <height>64</height>
        <font>font_label_bold</font>
        <textcolor>text</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <disabledcolor>text5</disabledcolor>
        <selectedcolor>text</selectedcolor>
        <textoffsetx>30</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="32" colordiffuse="focus">pill64.png</texturefocus>
        <texturenofocus border="32" colordiffuse="glass_strong">pill64.png</texturenofocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="togglebutton">
        <height>64</height>
        <font>font_label_bold</font>
        <textcolor>text</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <textoffsetx>30</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="32" colordiffuse="focus">pill64.png</texturefocus>
        <texturenofocus border="32" colordiffuse="glass_strong">pill64.png</texturenofocus>
        <alttexturefocus border="32" colordiffuse="focus">pill64.png</alttexturefocus>
        <alttexturenofocus border="32" colordiffuse="glass_strong">pill64.png</alttexturenofocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="radiobutton">
        <height>72</height>
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <disabledcolor>text5</disabledcolor>
        <textoffsetx>32</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
        <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
        <textureradioonfocus colordiffuse="on_focus">toggle_on.png</textureradioonfocus>
        <textureradioonnofocus colordiffuse="text">toggle_on.png</textureradioonnofocus>
        <textureradioofffocus colordiffuse="on_focus">toggle_off.png</textureradioofffocus>
        <textureradiooffnofocus colordiffuse="text">toggle_off.png</textureradiooffnofocus>
        <textureradioondisabled colordiffuse="text5">toggle_on.png</textureradioondisabled>
        <textureradiooffdisabled colordiffuse="text5">toggle_off.png</textureradiooffdisabled>
        <radiowidth>84</radiowidth>
        <radioheight>45</radioheight>
        <radioposx>-28</radioposx>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="spincontrolex">
        <height>72</height>
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <disabledcolor>text5</disabledcolor>
        <textoffsetx>32</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
        <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
        <textureup colordiffuse="text3">icons/arrow_left.png</textureup>
        <textureupfocus colordiffuse="on_focus">icons/arrow_left.png</textureupfocus>
        <texturedown colordiffuse="text3">icons/arrow_right.png</texturedown>
        <texturedownfocus colordiffuse="on_focus">icons/arrow_right.png</texturedownfocus>
        <textureupdisabled colordiffuse="text5">icons/arrow_left.png</textureupdisabled>
        <texturedowndisabled colordiffuse="text5">icons/arrow_right.png</texturedowndisabled>
        <spinwidth>32</spinwidth>
        <spinheight>32</spinheight>
        <spinposx>-26</spinposx>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="spincontrol">
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>text</focusedcolor>
        <textureup colordiffuse="text3">icons/arrow_up.png</textureup>
        <textureupfocus colordiffuse="text">icons/arrow_up.png</textureupfocus>
        <texturedown colordiffuse="text3">icons/arrow_down.png</texturedown>
        <texturedownfocus colordiffuse="text">icons/arrow_down.png</texturedownfocus>
        <width>32</width>
        <height>32</height>
    </default>
    <default type="sliderex">
        <height>72</height>
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <disabledcolor>text5</disabledcolor>
        <textoffsetx>32</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
        <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
        <texturesliderbar border="3" colordiffuse="hairline">pill6.png</texturesliderbar>
        <textureslidernib colordiffuse="text">nib.png</textureslidernib>
        <textureslidernibfocus colordiffuse="on_focus">nib.png</textureslidernibfocus>
        <sliderwidth>260</sliderwidth>
        <sliderheight>26</sliderheight>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="slider">
        <height>26</height>
        <texturesliderbar border="3" colordiffuse="hairline">pill6.png</texturesliderbar>
        <textureslidernib colordiffuse="text3">nib.png</textureslidernib>
        <textureslidernibfocus colordiffuse="text">nib.png</textureslidernibfocus>
    </default>
    <default type="edit">
        <height>72</height>
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <disabledcolor>text5</disabledcolor>
        <textoffsetx>32</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
        <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
        <pulseonselect>false</pulseonselect>
    </default>
    <default type="colorbutton">
        <height>72</height>
        <font>font_label</font>
        <textcolor>text2</textcolor>
        <focusedcolor>on_focus</focusedcolor>
        <textoffsetx>32</textoffsetx>
        <aligny>center</aligny>
        <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
        <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
        <texturecolormask>mask_circle.png</texturecolormask>
        <texturecolordisabledmask>mask_circle.png</texturecolordisabledmask>
        <colorwidth>40</colorwidth>
        <colorheight>40</colorheight>
        <colorposx>-30</colorposx>
    </default>
    <default type="progress">
        <height>6</height>
        <texturebg border="3" colordiffuse="glass_strong">pill6.png</texturebg>
        <lefttexture/>
        <midtexture border="3" colordiffuse="text">pill6.png</midtexture>
        <righttexture/>
        <overlaytexture/>
    </default>
    <default type="scrollbar">
        <width>6</width>
        <texturesliderbackground border="3" colordiffuse="14FFFFFF">pill6.png</texturesliderbackground>
        <texturesliderbar border="3" colordiffuse="4DFFFFFF">pill6.png</texturesliderbar>
        <texturesliderbarfocus border="3" colordiffuse="text">pill6.png</texturesliderbarfocus>
        <textureslidernib/>
        <textureslidernibfocus/>
        <showonepage>false</showonepage>
        <orientation>vertical</orientation>
    </default>
    <default type="list">
        <scrolltime tween="cubic" easing="out">260</scrolltime>
    </default>
    <default type="fixedlist">
        <scrolltime tween="cubic" easing="out">260</scrolltime>
    </default>
    <default type="wraplist">
        <scrolltime tween="cubic" easing="out">260</scrolltime>
    </default>
    <default type="panel">
        <scrolltime tween="cubic" easing="out">260</scrolltime>
    </default>
</includes>
