<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include file="Defaults.xml"/>
    <include file="Variables.xml"/>
    <include file="Includes_Views.xml"/>
    <include file="Includes_Home.xml"/>
    <include file="Includes_Settings.xml"/>
    <include file="Includes_Info.xml"/>

    <!-- ================= Constants ================= -->
    <constant name="SideGutter">96</constant>
    <constant name="PosterW">220</constant>
    <constant name="PosterH">330</constant>
    <constant name="LandW">400</constant>
    <constant name="LandH">225</constant>

    <!-- ================= Animations ================= -->
    <include name="Anim_Window">
        <animation effect="fade" start="0" end="100" time="300" tween="cubic" easing="out">WindowOpen</animation>
        <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    </include>
    <include name="Anim_SlideLeft">
        <animation effect="fade" start="0" end="100" time="350" delay="80">WindowOpen</animation>
        <animation effect="slide" start="-60,0" end="0,0" time="380" delay="80" tween="cubic" easing="out">WindowOpen</animation>
        <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    </include>
    <include name="Anim_SlideRight">
        <animation effect="fade" start="0" end="100" time="350" delay="120">WindowOpen</animation>
        <animation effect="slide" start="120,0" end="0,0" time="400" delay="120" tween="cubic" easing="out">WindowOpen</animation>
        <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    </include>
    <include name="Anim_SlideUp">
        <animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
        <animation effect="slide" start="0,60" end="0,0" time="380" tween="cubic" easing="out">WindowOpen</animation>
        <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
        <animation effect="slide" start="0,0" end="0,40" time="220" tween="cubic" easing="in">WindowClose</animation>
    </include>
    <include name="Anim_Dialog">
        <animation effect="fade" start="0" end="100" time="220">WindowOpen</animation>
        <animation effect="zoom" start="94" end="100" center="auto" time="260" tween="cubic" easing="out">WindowOpen</animation>
        <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
        <animation effect="zoom" start="100" end="96" center="auto" time="160" tween="cubic" easing="in">WindowClose</animation>
    </include>
    <include name="Anim_CardFocus">
        <animation effect="zoom" start="100" end="106" center="auto" time="200" tween="cubic" easing="out">Focus</animation>
        <animation effect="zoom" start="106" end="100" center="auto" time="160" tween="cubic" easing="out">UnFocus</animation>
    </include>

    <!-- ================= Backgrounds ================= -->
    <!-- Cinematic backdrop: solid base, artwork, left + bottom fades, vignette -->
    <include name="Backdrop">
        <param name="fanart">$INFO[ListItem.Art(fanart)]</param>
        <param name="visible">true</param>
        <definition>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture>white.png</texture>
                <colordiffuse>bg</colordiffuse>
            </control>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <fadetime>400</fadetime>
                <texture background="true">$PARAM[fanart]</texture>
                <visible>$PARAM[visible]</visible>
            </control>
            <include>BackdropFades</include>
        </definition>
    </include>
    <include name="BackdropFades">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1500</width>
            <height>1080</height>
            <texture>grad_left.png</texture>
            <colordiffuse>F50B1119</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>380</top>
            <width>1920</width>
            <height>700</height>
            <texture>grad_bottom.png</texture>
            <colordiffuse>FF0B1119</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>240</height>
            <texture>grad_top.png</texture>
            <colordiffuse>990B1119</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>vignette.png</texture>
            <colordiffuse>99000000</colordiffuse>
        </control>
    </include>
    <!-- Plain dark background for settings-type windows -->
    <include name="PlainBackground">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>bg</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio scalediffuse="false">scale</aspectratio>
            <texture background="true">$INFO[Skin.String(nuvio.bgfanart)]</texture>
            <colordiffuse>40FFFFFF</colordiffuse>
            <visible>!String.IsEmpty(Skin.String(nuvio.bgfanart))</visible>
        </control>
        <include>BackdropFades</include>
    </include>
    <!-- Dims everything behind a modal dialog -->
    <include name="DialogDim">
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>B3000000</colordiffuse>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
        </control>
    </include>

    <!-- ================= Glass surfaces ================= -->
    <include name="GlassPanel">
        <param name="left">0</param>
        <param name="top">0</param>
        <param name="width">600</param>
        <param name="height">400</param>
        <param name="body">panel</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <control type="image">
                    <left>-40</left>
                    <top>-40</top>
                    <right>-40</right>
                    <bottom>-40</bottom>
                    <texture border="88">panel_shadow.png</texture>
                    <colordiffuse>99000000</colordiffuse>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <right>0</right>
                    <bottom>0</bottom>
                    <texture border="48">panel.png</texture>
                    <colordiffuse>$PARAM[body]</colordiffuse>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <right>0</right>
                    <bottom>0</bottom>
                    <texture border="48">panel_edge.png</texture>
                    <colordiffuse>hairline</colordiffuse>
                </control>
            </control>
        </definition>
    </include>

    <!-- Pill used as a non-focusable info chip -->
    <include name="InfoPill">
        <param name="label"></param>
        <param name="visible">true</param>
        <param name="bg">glass</param>
        <param name="color">text2</param>
        <param name="font">font_small_bold</param>
        <definition>
            <control type="button">
                <width>auto</width>
                <height>44</height>
                <font>$PARAM[font]</font>
                <textoffsetx>20</textoffsetx>
                <textcolor>$PARAM[color]</textcolor>
                <disabledcolor>$PARAM[color]</disabledcolor>
                <texturenofocus border="22" colordiffuse="$PARAM[bg]">pill44.png</texturenofocus>
                <texturefocus border="22" colordiffuse="$PARAM[bg]">pill44.png</texturefocus>
                <enable>false</enable>
                <label>$PARAM[label]</label>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- Round icon button (textures are baked: white disc when focused) -->
    <include name="IconButton">
        <param name="id">0</param>
        <param name="icon">play</param>
        <param name="onclick">noop</param>
        <param name="visible">true</param>
        <param name="size">84</param>
        <definition>
            <control type="button" id="$PARAM[id]">
                <width>$PARAM[size]</width>
                <height>$PARAM[size]</height>
                <label></label>
                <texturefocus>buttons/$PARAM[icon]_fo.png</texturefocus>
                <texturenofocus>buttons/$PARAM[icon]_nf.png</texturenofocus>
                <onclick>$PARAM[onclick]</onclick>
                <visible>$PARAM[visible]</visible>
            </control>
        </definition>
    </include>

    <!-- ================= Text blocks ================= -->
    <!-- Clearlogo with large title fallback. logo = an infolabel name, e.g. ListItem.Art(clearlogo) -->
    <include name="LogoOrTitle">
        <param name="logo">ListItem.Art(clearlogo)</param>
        <param name="title">$VAR[ItemTitle]</param>
        <param name="left">0</param>
        <param name="top">0</param>
        <param name="width">640</param>
        <param name="height">220</param>
        <param name="font">font60</param>
        <definition>
            <control type="group">
                <left>$PARAM[left]</left>
                <top>$PARAM[top]</top>
                <width>$PARAM[width]</width>
                <height>$PARAM[height]</height>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>$PARAM[width]</width>
                    <height>$PARAM[height]</height>
                    <aspectratio align="left" aligny="bottom">keep</aspectratio>
                    <fadetime>300</fadetime>
                    <texture background="true">$INFO[$PARAM[logo]]</texture>
                    <visible>!String.IsEmpty($PARAM[logo])</visible>
                </control>
                <control type="textbox">
                    <left>0</left>
                    <top>0</top>
                    <width>$PARAM[width]</width>
                    <height>$PARAM[height]</height>
                    <font>$PARAM[font]</font>
                    <textcolor>text</textcolor>
                    <aligny>bottom</aligny>
                    <label>$PARAM[title]</label>
                    <visible>String.IsEmpty($PARAM[logo])</visible>
                </control>
            </control>
        </definition>
    </include>

    <!-- Clock in the top-right corner -->
    <include name="Clock">
        <control type="label">
            <right>96</right>
            <top>44</top>
            <width>300</width>
            <height>44</height>
            <align>right</align>
            <font>font_clock</font>
            <textcolor>text2</textcolor>
            <label>$INFO[System.Time]</label>
            <visible>!Skin.HasSetting(nuvio.hideclock)</visible>
        </control>
    </include>

    <!-- Page heading (top-left) -->
    <include name="PageHeading">
        <param name="label"></param>
        <param name="sub"></param>
        <definition>
            <control type="label">
                <left>96</left>
                <top>40</top>
                <width>1300</width>
                <height>52</height>
                <font>font36</font>
                <textcolor>text</textcolor>
                <label>$PARAM[label]</label>
            </control>
            <control type="label">
                <left>96</left>
                <top>92</top>
                <width>1300</width>
                <height>36</height>
                <font>font12</font>
                <textcolor>text4</textcolor>
                <label>$PARAM[sub]</label>
            </control>
        </definition>
    </include>

    <!-- Busy spinner -->
    <include name="Spinner">
        <param name="size">64</param>
        <definition>
            <control type="image">
                <width>$PARAM[size]</width>
                <height>$PARAM[size]</height>
                <texture>spinner.png</texture>
                <colordiffuse>text</colordiffuse>
                <animation effect="rotate" start="0" end="-360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
            </control>
        </definition>
    </include>
</includes>
