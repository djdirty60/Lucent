<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated: pause screen expressions and picture / sound badge variables -->
<includes>
    <!-- "Clean picture" when paused (issue #4): after a few seconds without a key press the bar and info go away -->
    <!-- a title of the video add-on that asks itself where to continue: no second question from Kodi -->
    <expression name="LucentOwnResume">String.StartsWith(ListItem.FilenameAndPath,plugin://plugin.video.lucent/) + ListItem.IsResumable + !ListItem.IsFolder + ![Skin.HasSetting(nuvio.ok.movie.page) + String.IsEqual(ListItem.DBType,movie) + String.IsEmpty(ListItem.Property(lucent_open))] + ![Skin.HasSetting(nuvio.ok.episode.page) + String.IsEqual(ListItem.DBType,episode)]</expression>
    <expression name="LucentPauseClean">Player.Paused + !Player.Seeking + [[String.IsEqual(Skin.String(nuvio.pauseinfo),clean3) + System.IdleTime(3)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),clean5) + System.IdleTime(5)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),clean10) + System.IdleTime(10)]]</expression>
    <expression name="NuvioPauseInfo">Player.Paused + !Player.Seeking + !Player.Caching + !String.IsEqual(Skin.String(nuvio.pauseinfo),off) + [[String.IsEmpty(Skin.String(nuvio.pauseinfo)) + System.IdleTime(5)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),3) + System.IdleTime(3)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),5) + System.IdleTime(5)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),10) + System.IdleTime(10)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),15) + System.IdleTime(15)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),30) + System.IdleTime(30)] | [String.IsEqual(Skin.String(nuvio.pauseinfo),60) + System.IdleTime(60)] | [String.StartsWith(Skin.String(nuvio.pauseinfo),clean) + System.IdleTime(1)]]</expression>
    <expression name="LucentDV2Named">String.IsEqual(VideoPlayer.HdrType,dolbyvision) + [String.Contains(Player.Filename,.dv2.) | String.Contains(Player.Filename,.dv2-) | String.Contains(Player.Filename,-dv2.) | String.Contains(Player.Filename,_dv2_) | String.Contains(Player.Filename,.dv2_) | String.Contains(Player.Filename,dovi2) | String.Contains(Player.Filename,dovi.2.) | String.Contains(Player.Filename,dolby.vision.2.) | String.Contains(Player.Filename,dolbyvision2) | String.Contains(Player.FilenameAndPath,.dv2.) | String.Contains(Player.FilenameAndPath,.dv2-) | String.Contains(Player.FilenameAndPath,-dv2.) | String.Contains(Player.FilenameAndPath,_dv2_) | String.Contains(Player.FilenameAndPath,.dv2_) | String.Contains(Player.FilenameAndPath,dovi2) | String.Contains(Player.FilenameAndPath,dovi.2.) | String.Contains(Player.FilenameAndPath,dolby.vision.2.) | String.Contains(Player.FilenameAndPath,dolbyvision2)]</expression>
    <variable name="NuvioFlagImg_res">
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,8K) + !String.IsEmpty(Skin.String(nuvio.flag.8k))">$INFO[Skin.String(nuvio.flag.8k)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,8K)">flags/8K.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,4K) + !String.IsEmpty(Skin.String(nuvio.flag.4k))">$INFO[Skin.String(nuvio.flag.4k)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,4K)">flags/4K.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,1080) + !String.IsEmpty(Skin.String(nuvio.flag.1080))">$INFO[Skin.String(nuvio.flag.1080)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,1080)">flags/1080P.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,720) + !String.IsEmpty(Skin.String(nuvio.flag.720))">$INFO[Skin.String(nuvio.flag.720)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,720)">flags/720P.png</value>
        <value condition="[String.IsEqual(VideoPlayer.VideoResolution,480) | String.IsEqual(VideoPlayer.VideoResolution,540) | String.IsEqual(VideoPlayer.VideoResolution,576)] + !String.IsEmpty(Skin.String(nuvio.flag.sd))">$INFO[Skin.String(nuvio.flag.sd)]</value>
        <value condition="[String.IsEqual(VideoPlayer.VideoResolution,480) | String.IsEqual(VideoPlayer.VideoResolution,540) | String.IsEqual(VideoPlayer.VideoResolution,576)]">flags/SD.png</value>
    </variable>
    <variable name="NuvioFlagImg_hdr">
        <value condition="$EXP[LucentDV2Named]">flags/DV2.png</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision) + !String.IsEmpty(Skin.String(nuvio.flag.dolbyvision))">$INFO[Skin.String(nuvio.flag.dolbyvision)]</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision)">flags/DV.png</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hdr10plus) + !String.IsEmpty(Skin.String(nuvio.flag.hdr10plus))">$INFO[Skin.String(nuvio.flag.hdr10plus)]</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hdr10plus)">flags/HDR10+.png</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hdr10) + !String.IsEmpty(Skin.String(nuvio.flag.hdr10))">$INFO[Skin.String(nuvio.flag.hdr10)]</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hdr10)">flags/HDR10.png</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hlg) + !String.IsEmpty(Skin.String(nuvio.flag.hlg))">$INFO[Skin.String(nuvio.flag.hlg)]</value>
        <value condition="String.IsEqual(VideoPlayer.HdrType,hlg)">flags/HLG.png</value>
    </variable>
    <variable name="NuvioFlagImg_vcodec">
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,hevc) + !String.IsEmpty(Skin.String(nuvio.flag.hevc))">$INFO[Skin.String(nuvio.flag.hevc)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,hevc)">flags/HEVC.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,av1) + !String.IsEmpty(Skin.String(nuvio.flag.av1))">$INFO[Skin.String(nuvio.flag.av1)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,av1)">flags/AV1.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,h264) + !String.IsEmpty(Skin.String(nuvio.flag.h264))">$INFO[Skin.String(nuvio.flag.h264)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,h264)">flags/AVC.png</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,vp9) + !String.IsEmpty(Skin.String(nuvio.flag.vp9))">$INFO[Skin.String(nuvio.flag.vp9)]</value>
        <value condition="String.IsEqual(VideoPlayer.VideoCodec,vp9)">flags/VP9.png</value>
    </variable>
    <variable name="NuvioFlagImg_atmos">
        <value condition="[String.IsEqual(VideoPlayer.AudioCodec,truehd_atmos) | String.IsEqual(VideoPlayer.AudioCodec,eac3_ddp_atmos)] + !String.IsEmpty(Skin.String(nuvio.flag.atmos))">$INFO[Skin.String(nuvio.flag.atmos)]</value>
        <value condition="[String.IsEqual(VideoPlayer.AudioCodec,truehd_atmos) | String.IsEqual(VideoPlayer.AudioCodec,eac3_ddp_atmos)]">flags/ATMOS.png</value>
    </variable>
    <variable name="NuvioFlagImg_acodec">
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,dtshd_ma_x) + !String.IsEmpty(Skin.String(nuvio.flag.dtsx))">$INFO[Skin.String(nuvio.flag.dtsx)]</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,dtshd_ma_x)">flags/DTS-X.png</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,truehd) + !String.IsEmpty(Skin.String(nuvio.flag.truehd))">$INFO[Skin.String(nuvio.flag.truehd)]</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,truehd)">flags/TRUEHD.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma) + !String.IsEmpty(Skin.String(nuvio.flag.dtshd_ma))">$INFO[Skin.String(nuvio.flag.dtshd_ma)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma)">flags/DTS-HDMA.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra) + !String.IsEmpty(Skin.String(nuvio.flag.dtshd_hra))">$INFO[Skin.String(nuvio.flag.dtshd_hra)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra)">flags/DTS-HDHR.png</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,dts) + !String.IsEmpty(Skin.String(nuvio.flag.dts))">$INFO[Skin.String(nuvio.flag.dts)]</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,dts)">flags/DTS.png</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,eac3) + !String.IsEmpty(Skin.String(nuvio.flag.eac3))">$INFO[Skin.String(nuvio.flag.eac3)]</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,eac3)">flags/DD+.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,ac3) + !String.IsEmpty(Skin.String(nuvio.flag.ac3))">$INFO[Skin.String(nuvio.flag.ac3)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,ac3)">flags/DD.png</value>
        <value condition="[String.StartsWith(VideoPlayer.AudioCodec,aac) | String.StartsWith(VideoPlayer.AudioCodec,he_aac)] + !String.IsEmpty(Skin.String(nuvio.flag.aac))">$INFO[Skin.String(nuvio.flag.aac)]</value>
        <value condition="[String.StartsWith(VideoPlayer.AudioCodec,aac) | String.StartsWith(VideoPlayer.AudioCodec,he_aac)]">flags/AAC.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,flac) + !String.IsEmpty(Skin.String(nuvio.flag.flac))">$INFO[Skin.String(nuvio.flag.flac)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,flac)">flags/FLAC.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,opus) + !String.IsEmpty(Skin.String(nuvio.flag.opus))">$INFO[Skin.String(nuvio.flag.opus)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,opus)">flags/OPUS.png</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,pcm) + !String.IsEmpty(Skin.String(nuvio.flag.pcm))">$INFO[Skin.String(nuvio.flag.pcm)]</value>
        <value condition="String.StartsWith(VideoPlayer.AudioCodec,pcm)">flags/PCM.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,mp3) + !String.IsEmpty(Skin.String(nuvio.flag.mp3))">$INFO[Skin.String(nuvio.flag.mp3)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioCodec,mp3)">flags/MP3.png</value>
    </variable>
    <variable name="NuvioFlagImg_ch">
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,8) + !String.IsEmpty(Skin.String(nuvio.flag.71))">$INFO[Skin.String(nuvio.flag.71)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,8)">flags/7.1.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,7) + !String.IsEmpty(Skin.String(nuvio.flag.61))">$INFO[Skin.String(nuvio.flag.61)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,7)">flags/6.1.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,6) + !String.IsEmpty(Skin.String(nuvio.flag.51))">$INFO[Skin.String(nuvio.flag.51)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,6)">flags/5.1.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,2) + !String.IsEmpty(Skin.String(nuvio.flag.20))">$INFO[Skin.String(nuvio.flag.20)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,2)">flags/2.0.png</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,1) + !String.IsEmpty(Skin.String(nuvio.flag.10))">$INFO[Skin.String(nuvio.flag.10)]</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,1)">flags/1.0.png</value>
    </variable>
</includes>
