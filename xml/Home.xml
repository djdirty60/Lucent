        <!-- ============ Backdrop ============ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>bg</colordiffuse>
        </control>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
            <include>HomeBackdrops</include>
        </control>
        <include>BackdropFades</include>
        <control type="image">
            <left>0</left>
            <top>520</top>
            <width>1920</width>
            <height>560</height>
            <texture>grad_bottom.png</texture>
            <colordiffuse>E60B1119</colordiffuse>
        </control>

        <!-- ============ Hero + rows (slide right while the sidebar is open) ============ -->
        <control type="group">
            <animation effect="slide" start="0,0" end="150,0" time="300" tween="cubic" easing="out" condition="ControlGroup(9000).HasFocus">Conditional</animation>
            <animation effect="fade" start="100" end="45" time="300" condition="ControlGroup(9000).HasFocus">Conditional</animation>

            <control type="group">
                <include>Anim_SlideLeft</include>
                <include>HomeHeroes</include>
            </control>

