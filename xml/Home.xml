                <itemgap>0</itemgap>
                <scrolltime tween="cubic" easing="out">320</scrolltime>
                <onleft>9000</onleft>
                <include>HomeRows</include>
            </control>

            <!-- Shown when no row has content yet -->
            <control type="group">
                <left>160</left>
                <top>620</top>
                <visible>!Integer.IsGreater(Container(8001).NumItems,0) + !Integer.IsGreater(Container(8002).NumItems,0) + !Integer.IsGreater(Container(8003).NumItems,0) + !Integer.IsGreater(Container(8004).NumItems,0) + !Integer.IsGreater(Container(8005).NumItems,0) + !Integer.IsGreater(Container(8006).NumItems,0) + !Container(8001).IsUpdating + !Container(8003).IsUpdating</visible>
