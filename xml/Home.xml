<?xml version="1.0" encoding="UTF-8"?>
<!-- Nuvio Arc: home screen -->
<window>
    <defaultcontrol always="true">9100</defaultcontrol>
    <backgroundcolor>bg</backgroundcolor>
    <!-- First time: write the default menu; once per session: select the start tab -->
    <onload condition="String.IsEmpty(Skin.String(nuvio.menu.version))">RunScript(special://skin/scripts/menu.py,init)</onload>
    <onload condition="String.IsEmpty(Window(home).Property(nuvio.started)) + !String.IsEmpty(Skin.String(nuvio.homepos))">Control.SetFocus(9000,$INFO[Skin.String(nuvio.homepos)])</onload>
    <onload condition="String.IsEmpty(Window(home).Property(nuvio.started))">SetFocus(9100)</onload>
    <onload condition="!$EXP[NuvioAnyRow]">SetFocus(9000)</onload>
    <onload>SetProperty(nuvio.started,1,home)</onload>
    <controls>
        <!-- ============ Backdrop ============ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>bg</colordiffuse>
        </control>
        <control type="group">
            <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
            <include>HomeBackdrops</include>
        </control>
        <include>BackdropFades</include>
        <control type="image">
            <left>0</left>
            <top>520</top>
            <width>1920</width>
            <height>560</height>
            <texture>grad_bottom.png</texture>
            <colordiffuse>bg_90</colordiffuse>
        </control>

        <!-- ============ Hero + rows (slide right while the side menu is open) ============ -->
        <control type="group">
            <animation effect="slide" start="0,0" end="230,0" time="300" tween="cubic" easing="out" condition="Control.HasFocus(9000) + !System.HasVisibleModalDialog">Conditional</animation>
            <animation effect="fade" start="100" end="45" time="300" condition="Control.HasFocus(9000) + !System.HasVisibleModalDialog">Conditional</animation>

            <control type="group">
                <include>Anim_SlideLeft</include>
                <include>HomeHeroes</include>
            </control>

            <control type="grouplist" id="9100">
                <include>Anim_SlideUp</include>
                <left>160</left>
                <top>586</top>
                <width>1760</width>
                <height>494</height>
                <orientation>vertical</orientation>
                <itemgap>0</itemgap>
                <scrolltime tween="cubic" easing="out">320</scrolltime>
                <onleft>9000</onleft>
                <include>HomeRows</include>
            </control>

            <!-- Shown when the tab has no widgets (or none of them has content) -->
            <control type="group">
                <left>160</left>
                <top>620</top>
                <visible>!$EXP[NuvioAnyRow]</visible>
                <animation effect="fade" start="0" end="100" time="300" delay="1500">Visible</animation>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>1400</width>
                    <height>48</height>
                    <font>font_mainmenu_small</font>
                    <label>$LOCALIZE[31088]</label>
                </control>
                <control type="textbox">
                    <left>0</left>
                    <top>56</top>
                    <width>1100</width>
                    <height>120</height>
                    <font>font_body</font>
                    <label>$LOCALIZE[31104]</label>
                    <visible>String.IsEmpty(Container(9000).ListItem.Property(w1.path)) + String.IsEmpty(Skin.String(nuvio.home.w1.path))</visible>
                </control>
                <control type="textbox">
                    <left>0</left>
                    <top>56</top>
                    <width>1100</width>
                    <height>120</height>
                    <font>font_body</font>
                    <label>$LOCALIZE[31089]</label>
                    <visible>![String.IsEmpty(Container(9000).ListItem.Property(w1.path)) + String.IsEmpty(Skin.String(nuvio.home.w1.path))]</visible>
                </control>
            </control>
        </control>

        <!-- ============ Side menu ============ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>820</width>
            <height>1080</height>
            <texture>grad_left.png</texture>
            <colordiffuse>bg_98</colordiffuse>
            <animation effect="fade" start="0" end="100" time="250">Visible</animation>
            <animation effect="fade" start="100" end="0" time="200">Hidden</animation>
            <visible>Control.HasFocus(9000) + !System.HasVisibleModalDialog</visible>
        </control>
        <control type="group">
            <include>Anim_Window</include>
            <control type="image">
                <left>36</left>
                <top>64</top>
                <width>48</width>
                <height>48</height>
                <texture colordiffuse="text">icons/logo.png</texture>
            </control>
            <control type="label">
                <left>100</left>
                <top>62</top>
                <width>280</width>
                <height>52</height>
                <font>font27_title</font>
                <label>[B]NUVIO[/B] Arc</label>
                <visible>Control.HasFocus(9000) + !System.HasVisibleModalDialog</visible>
            </control>
            <control type="list" id="9000">
                <left>24</left>
                <top>180</top>
                <width>360</width>
                <height>870</height>
                <orientation>vertical</orientation>
                <scrolltime tween="cubic" easing="out">200</scrolltime>
                <onright condition="$EXP[NuvioAnyRow]">9100</onright>
                <onback condition="$EXP[NuvioAnyRow]">9100</onback>
                <itemlayout width="360" height="84">
                    <control type="image">
                        <left>18</left>
                        <top>24</top>
                        <width>36</width>
                        <height>36</height>
                        <texture colordiffuse="on_focus">$INFO[ListItem.Icon]</texture>
                        <visible>false</visible>
                    </control>
                    <control type="image">
                        <left>18</left>
                        <top>24</top>
                        <width>36</width>
                        <height>36</height>
                        <texture colordiffuse="text3">$INFO[ListItem.Icon]</texture>
                        <visible>!false + [Control.HasFocus(9000) | !Skin.HasSetting(nuvio.sideicons.hide)]</visible>
                    </control>
                    <control type="label">
                        <left>76</left>
                        <top>8</top>
                        <width>250</width>
                        <height>68</height>
                        <font>font_mainmenu_small</font>
                        <textcolor>text2</textcolor>
                        <selectedcolor>text2</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>Control.HasFocus(9000) + !System.HasVisibleModalDialog</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="360" height="84">
                    <control type="image">
                        <left>0</left>
                        <top>10</top>
                        <width>340</width>
                        <height>64</height>
                        <texture border="32" colordiffuse="focus">pill64.png</texture>
                        <visible>Control.HasFocus(9000) + !System.HasVisibleModalDialog</visible>
                    </control>
                    <control type="image">
                        <left>2</left>
                        <top>28</top>
                        <width>4</width>
                        <height>28</height>
                        <texture>white.png</texture>
                        <colordiffuse>text</colordiffuse>
                        <visible>!Control.HasFocus(9000)</visible>
                    </control>
                    <control type="image">
                        <left>18</left>
                        <top>24</top>
                        <width>36</width>
                        <height>36</height>
                        <texture colordiffuse="on_focus">$INFO[ListItem.Icon]</texture>
                        <visible>Control.HasFocus(9000)</visible>
                    </control>
                    <control type="image">
                        <left>18</left>
                        <top>24</top>
                        <width>36</width>
                        <height>36</height>
                        <texture colordiffuse="text">$INFO[ListItem.Icon]</texture>
                        <visible>!Control.HasFocus(9000) + [Control.HasFocus(9000) | !Skin.HasSetting(nuvio.sideicons.hide)]</visible>
                    </control>
                    <control type="label">
                        <left>76</left>
                        <top>8</top>
                        <width>250</width>
                        <height>68</height>
                        <font>font_mainmenu_small</font>
                        <textcolor>on_focus</textcolor>
                        <selectedcolor>on_focus</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>Control.HasFocus(9000) + !System.HasVisibleModalDialog</visible>
                    </control>
                </focusedlayout>
                <content>
                    <include>HomeMenuItems</include>
                </content>
            </control>
        </control>

        <include>Clock</include>
    </controls>
</window>
