<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <variable name="GuideFavLabel">
        <value condition="String.IsEqual(Container(11).ListItem.Label,Skin.String(lucent.guide.group)) + String.StartsWith(System.Language,Dutch)">★  Niet meer favoriet</value>
        <value condition="String.IsEqual(Container(11).ListItem.Label,Skin.String(lucent.guide.group))">★  Remove favourite</value>
        <value condition="String.StartsWith(System.Language,Dutch)">★  Favoriete groep</value>
        <value>★  Favourite group</value>
    </variable>
    <!-- Title shown big: the show for episodes, otherwise the title -->
    <variable name="ItemTitle">
        <value condition="!String.IsEmpty(ListItem.TVShowTitle) + [String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)]">$INFO[ListItem.TVShowTitle]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
        <value>$INFO[ListItem.Label]</value>
    </variable>
    <variable name="ItemPoster">
        <value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value>$INFO[ListItem.Icon]</value>
    </variable>
    <variable name="ItemClearlogo">
        <value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
        <value>$INFO[ListItem.Art(tvshow.clearlogo)]</value>
    </variable>
    <variable name="ItemLandscape">
        <value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.landscape))">$INFO[ListItem.Art(tvshow.landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value>$INFO[ListItem.Icon]</value>
    </variable>
    <variable name="ItemFanart">
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Property(Fanart_Image))">$INFO[ListItem.Property(Fanart_Image)]</value>
        <value>$INFO[Container.Art(fanart)]</value>
    </variable>
    <!-- season page: scores of the season (Seren), else of its series in the Kodi library (list 5699) -->
    <!-- TV windows (gen_pvr.py): the picture and the "now" title of the focused channel / programme / recording -->
    <variable name="LucentPvrInfoArt">
        <value condition="!String.IsEmpty(ListItem.EpgEventIcon)">$INFO[ListItem.EpgEventIcon]</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.ChannelLogo)">$INFO[ListItem.ChannelLogo]</value>
        <value>$INFO[ListItem.Icon]</value>
    </variable>
    <variable name="LucentPvrNowTitle">
        <value condition="!String.IsEmpty(ListItem.EpgEventTitle)">$INFO[ListItem.EpgEventTitle]</value>
        <value>$INFO[ListItem.Title]</value>
    </variable>
    <variable name="LucentShowScoresPath">
        <value condition="System.HasAddon(script.lucent.library) + !String.IsEmpty(Container(56).ListItem.TvShowDBID) + String.IsEmpty(Container(56).ListItem.Rating(imdb)) + String.IsEmpty(Container(56).ListItem.Rating(trakt))">plugin://script.lucent.library/?action=lib&amp;kind=showinfo&amp;dbid=$INFO[Container(56).ListItem.TvShowDBID]</value>
    </variable>
    <variable name="LucentS56Imdb">
        <value condition="!String.IsEmpty(Container(56).ListItem.Rating(imdb))">$INFO[Container(56).ListItem.Rating(imdb)]</value>
        <value>$INFO[Container(5699).ListItem.Rating(imdb)]</value>
    </variable>
    <variable name="LucentS56Trakt">
        <value condition="!String.IsEmpty(Container(56).ListItem.Rating(trakt))">$INFO[Container(56).ListItem.Rating(trakt)]</value>
        <value>$INFO[Container(5699).ListItem.Rating(trakt)]</value>
    </variable>
    <variable name="LucentS56Tmdb">
        <value condition="!String.IsEmpty(Container(56).ListItem.Rating(tmdb))">$INFO[Container(56).ListItem.Rating(tmdb)]</value>
        <value condition="!String.IsEmpty(Container(56).ListItem.Rating(themoviedb))">$INFO[Container(56).ListItem.Rating(themoviedb)]</value>
        <value condition="!String.IsEmpty(Container(5699).ListItem.Rating(tmdb))">$INFO[Container(5699).ListItem.Rating(tmdb)]</value>
        <value>$INFO[Container(5699).ListItem.Rating(themoviedb)]</value>
    </variable>
    <variable name="LucentSeasonSummary">
        <value condition="Integer.IsGreater(Container(5601).NumItems,0) + !String.IsEmpty(Container(56).ListItem.Property(WatchedEpisodes))">[B]$INFO[Container(56).ListItem.Label][/B]   [COLOR FF6F7C88]|[/COLOR]   $INFO[Container(5601).NumItems] $LOCALIZE[31563]   [COLOR FF6F7C88]|[/COLOR]   [COLOR FF4CC38A][B]✓ $INFO[Container(56).ListItem.Property(WatchedEpisodes)] $LOCALIZE[31564][/B][/COLOR]</value>
        <value condition="Integer.IsGreater(Container(5601).NumItems,0)">[B]$INFO[Container(56).ListItem.Label][/B]   [COLOR FF6F7C88]|[/COLOR]   $INFO[Container(5601).NumItems] $LOCALIZE[31563]</value>
        <value>[B]$INFO[Container(56).ListItem.Label][/B]</value>
    </variable>
    <variable name="LucentLibStatus">
        <value condition="!String.IsEmpty(Window(home).Property(lucent.lib.movies))">$INFO[Window(home).Property(lucent.lib.movies)] $LOCALIZE[31583]  ·  $INFO[Window(home).Property(lucent.lib.shows)] $LOCALIZE[31584]  ·  $LOCALIZE[31585] $INFO[Window(home).Property(lucent.lib.last)]</value>
        <value>$LOCALIZE[31574]</value>
    </variable>
    <variable name="LucentLibEvery">
        <value condition="String.IsEqual(Skin.String(lucent.lib.every),6) | String.IsEqual(Skin.String(lucent.lib.every),12) | String.IsEqual(Skin.String(lucent.lib.every),24)">$LOCALIZE[31587] $INFO[Skin.String(lucent.lib.every)] $LOCALIZE[31578]</value>
        <value>$LOCALIZE[31577]</value>
    </variable>
    <variable name="LucentLibEveryNext">
        <value condition="String.IsEqual(Skin.String(lucent.lib.every),6)">12</value>
        <value condition="String.IsEqual(Skin.String(lucent.lib.every),12)">24</value>
        <value condition="String.IsEqual(Skin.String(lucent.lib.every),24)">0</value>
        <value>6</value>
    </variable>
    <variable name="LucentFilterType">
        <value condition="Container.Content(tvshows)">tvshow</value>
        <value>movie</value>
    </variable>
    <variable name="LucentFilterNode">
        <value condition="Container.Content(tvshows)">tvshows</value>
        <value>movies</value>
    </variable>
    <variable name="LucentFilterPick">
        <value condition="Container.Content(tvshows)">1</value>
        <value>0</value>
    </variable>
    <variable name="LucentGeminiState">
        <value condition="!String.IsEmpty(Skin.String(lucent.gemini.key))">$LOCALIZE[31603]</value>
        <value>$LOCALIZE[31604]</value>
    </variable>
    <variable name="LucentEpThumb">
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value>$INFO[ListItem.Art(fanart)]</value>
    </variable>
    <variable name="ItemLogo">
        <value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(tvshow.clearlogo))">$INFO[ListItem.Art(tvshow.clearlogo)]</value>
    </variable>
    <variable name="ItemSE">
        <value condition="!String.IsEmpty(ListItem.Season) + !String.IsEmpty(ListItem.Episode) + Integer.IsGreater(ListItem.Episode,0)">S$INFO[ListItem.Season] · E$INFO[ListItem.Episode]</value>
        <value condition="!String.IsEmpty(ListItem.Season) + String.IsEqual(ListItem.DBType,season)">$LOCALIZE[31061] $INFO[ListItem.Season]</value>
    </variable>
    <variable name="ItemRating">
        <value condition="!String.IsEmpty(ListItem.Rating)">★ $INFO[ListItem.Rating]</value>
    </variable>
    <variable name="ItemDuration">
        <value condition="Integer.IsGreater(ListItem.Duration(mins),59)">$INFO[ListItem.Duration(h)]u $INFO[ListItem.Duration(mm)]m</value>
        <value condition="Integer.IsGreater(ListItem.Duration(mins),0)">$INFO[ListItem.Duration(mins)] min</value>
    </variable>
    <variable name="LiveRes">
        <value condition="String.IsEqual(VideoPlayer.VideoResolution,4K) | String.IsEqual(VideoPlayer.VideoResolution,8K)">$INFO[VideoPlayer.VideoResolution]</value>
        <value>$INFO[VideoPlayer.VideoResolution]P</value>
    </variable>
    <variable name="LiveFps">
        <value condition="String.StartsWith(Player.Process(videofps),23.9) | String.StartsWith(Player.Process(videofps),24)">24</value>
        <value condition="String.StartsWith(Player.Process(videofps),25)">25</value>
        <value condition="String.StartsWith(Player.Process(videofps),29.9) | String.StartsWith(Player.Process(videofps),30)">30</value>
        <value condition="String.StartsWith(Player.Process(videofps),50)">50</value>
        <value condition="String.StartsWith(Player.Process(videofps),59.9) | String.StartsWith(Player.Process(videofps),60)">60</value>
        <value>$INFO[Player.Process(videofps)]</value>
    </variable>
    <variable name="LiveAudio">
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,2)">STEREO</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,1)">MONO</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,6)">5.1</value>
        <value condition="String.IsEqual(VideoPlayer.AudioChannels,8)">7.1</value>
        <value>$INFO[VideoPlayer.AudioChannels] CH</value>
    </variable>
    <variable name="PlayerTitle">
        <value condition="Pvr.IsPlayingTV + !String.IsEmpty(VideoPlayer.ChannelName)">$INFO[VideoPlayer.ChannelNumberLabel,,   ]$INFO[VideoPlayer.ChannelName]</value>
        <value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
        <value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
        <value>$INFO[Player.Title]</value>
    </variable>
    <variable name="PlayerSubtitle">
        <value condition="Pvr.IsPlayingTV">$INFO[VideoPlayer.Genre]</value>
        <value condition="!String.IsEmpty(VideoPlayer.TVShowTitle) + !String.IsEmpty(VideoPlayer.Season)">S$INFO[VideoPlayer.Season] · E$INFO[VideoPlayer.Episode]   $INFO[VideoPlayer.Title]</value>
        <value>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Genre,   ,]</value>
    </variable>
    <variable name="PlayerLogo">
        <value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[Player.Art(clearlogo)]</value>
        <value condition="!String.IsEmpty(Player.Art(tvshow.clearlogo))">$INFO[Player.Art(tvshow.clearlogo)]</value>
    </variable>
    <variable name="FileIcon">
        <value condition="ListItem.IsParentFolder">DefaultFolderBack.png</value>
        <value condition="!String.IsEmpty(ListItem.Icon)">$INFO[ListItem.Icon]</value>
        <value condition="ListItem.IsFolder">DefaultFolder.png</value>
        <value>DefaultFile.png</value>
    </variable>
