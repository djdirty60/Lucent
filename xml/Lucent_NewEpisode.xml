<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent 2.1.8: the pop-up for a new episode, a whole new season at once, or a film that is out (scripts/agenda_core.py,
     class Announce). Poster on the left; Watch now / Open series / Later. -->
<window type="dialog">
    <defaultcontrol always="true">10</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="slide" start="0,40" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>8C05070C</colordiffuse>
        </control>
        <control type="group">
            <left>260</left>
            <top>330</top>
            <control type="image">
                <left>-24</left>
                <top>-14</top>
                <width>1448</width>
                <height>548</height>
                <texture border="44">rr20_glow.png</texture>
                <colordiffuse>73000000</colordiffuse>
            </control>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1400</width>
                <height>500</height>
                <texture border="20">rr20.png</texture>
                <colordiffuse>EB202228</colordiffuse>
            </control>
            <control type="label">
                <left>60</left>
                <top>40</top>
                <width>1280</width>
                <height>56</height>
                <font>font_heading_small</font>
                <textcolor>text</textcolor>
                <label>$INFO[Window.Property(ne.head)]</label>
            </control>
            <control type="image">
                <left>60</left>
                <top>130</top>
                <width>230</width>
                <height>330</height>
                <texture border="14">rr14.png</texture>
                <colordiffuse>14FFFFFF</colordiffuse>
            </control>
            <control type="image">
                <left>60</left>
                <top>130</top>
                <width>230</width>
                <height>330</height>
                <aspectratio>scale</aspectratio>
                <texture diffuse="mask_poster.png" background="true">$INFO[Window.Property(ne.poster)]</texture>
            </control>
            <control type="label">
                <left>330</left>
                <top>130</top>
                <width>1010</width>
                <height>64</height>
                <font>font37</font>
                <textcolor>text</textcolor>
                <label>$INFO[Window.Property(ne.title)]</label>
            </control>
            <control type="label">
                <left>330</left>
                <top>200</top>
                <width>1010</width>
                <height>50</height>
                <font>font14_bold</font>
                <textcolor>text</textcolor>
                <label>$INFO[Window.Property(ne.line)]</label>
            </control>
            <control type="label">
                <left>330</left>
                <top>254</top>
                <width>1010</width>
                <height>44</height>
                <font>font12</font>
                <textcolor>text2</textcolor>
                <label>$INFO[Window.Property(ne.when)]</label>
            </control>
            <control type="grouplist" id="9000">
                <left>330</left>
                <top>340</top>
                <width>1040</width>
                <height>96</height>
                <orientation>horizontal</orientation>
                <itemgap>22</itemgap>
                <control type="button" id="10">
                    <width>auto</width>
                    <height>96</height>
                    <font>font14_bold</font>
                    <textoffsetx>40</textoffsetx>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>text</textcolor>
                    <focusedcolor>text</focusedcolor>
                    <texturefocus border="22">rr20_btnfocus.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="14FFFFFF">rr20.png</texturenofocus>
                    <label>$INFO[Window.Property(ne.watch)]</label>
                </control>
                <control type="button" id="11">
                    <width>auto</width>
                    <height>96</height>
                    <font>font14_bold</font>
                    <textoffsetx>40</textoffsetx>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>text</textcolor>
                    <focusedcolor>text</focusedcolor>
                    <texturefocus border="22">rr20_btnfocus.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="14FFFFFF">rr20.png</texturenofocus>
                    <label>$INFO[Window.Property(ne.open)]</label>
                    <visible>!String.IsEmpty(Window.Property(ne.open))</visible>
                </control>
                <control type="button" id="12">
                    <width>auto</width>
                    <height>96</height>
                    <font>font14_bold</font>
                    <textoffsetx>40</textoffsetx>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>text</textcolor>
                    <focusedcolor>text</focusedcolor>
                    <texturefocus border="22">rr20_btnfocus.png</texturefocus>
                    <texturenofocus border="20" colordiffuse="14FFFFFF">rr20.png</texturenofocus>
                    <label>$INFO[Window.Property(ne.later)]</label>
                </control>
            </control>
        </control>
    </controls>
</window>
