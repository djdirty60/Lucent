<!-- Lucent: volume (example C) - a card at the bottom with growing blocks; above it a note when the sound goes straight to the
     amplifier. scripts/volume.py keeps Window(home).Property(lucent.vol.*) up to date while it is open (Kodi gives the volume in dB). -->
<window>
    <depth>DepthMax</depth>
    <onload>RunScript(special://skin/scripts/volume.py)</onload>
    <animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
    <animation effect="slide" start="0,30" end="0,0" time="200" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
    <controls>
        <!-- 2.1.7 (#20): when the sound is muted Kodi keeps this window open; like Kodi's own skin the card then fades
             away after a second instead of staying over Home (scripts/volume.py sets lucent.vol.hide) -->
        <control type="group">
            <left>560</left>
            <top>800</top>
            <visible>String.IsEmpty(Window(home).Property(lucent.vol.hide))</visible>
            <animation effect="fade" time="300">VisibleChange</animation>
