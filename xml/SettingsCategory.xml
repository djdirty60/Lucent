<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <onload condition="Skin.HasSetting(lucent.kids)">RunScript(special://skin/scripts/kids.py,guard)</onload>
    <backgroundcolor>bg</backgroundcolor>
    <controls>
        <include>PlainBackground</include>
        <include>Clock</include>
        <control type="label" id="2">
            <visible>false</visible>
        </control>

        <!-- Left: heading and the categories of this section -->
        <control type="label">
            <left>96</left>
            <top>52</top>
            <width>440</width>
            <height>52</height>
            <font>font_heading_small</font>
            <textcolor>text</textcolor>
            <label>$LOCALIZE[5]</label>
        </control>
        <control type="label">
            <left>96</left>
            <top>100</top>
            <width>440</width>
            <height>34</height>
            <font>font10</font>
            <textcolor>text4</textcolor>
            <label>$INFO[Control.GetLabel(2)]</label>
        </control>
        <control type="group">
            <include>Anim_SlideRight</include>
            <control type="grouplist" id="3">
                <left>80</left>
                <top>160</top>
                <width>460</width>
                <height>760</height>
                <itemgap>2</itemgap>
                <onright>5</onright>
                <onup>3</onup>
                <ondown>20</ondown>
                <usecontrolcoords>true</usecontrolcoords>
            </control>
            <include content="CategoryTemplate"><param name="width">440</param></include>
            <!-- Settings level (Basic / Standard / Advanced / Expert), label set by Kodi -->
            <control type="button" id="20">
                <left>96</left>
                <top>956</top>
                <width>420</width>
                <height>60</height>
                <font>font10_bold</font>
                <textcolor>text3</textcolor>
                <focusedcolor>on_focus</focusedcolor>
                <textoffsetx>28</textoffsetx>
                <texturefocus border="20" colordiffuse="focus">rr20.png</texturefocus>
                <texturenofocus border="20" colordiffuse="card">rr20.png</texturenofocus>
                <onup>3</onup>
                <ondown>3</ondown>
                <onright>5</onright>
            </control>
        </control>
        <control type="image">
            <left>560</left>
            <top>160</top>
            <width>2</width>
            <height>860</height>
            <texture>white.png</texture>
            <colordiffuse>separator</colordiffuse>
        </control>

        <!-- Right: title, explanation and the settings -->
        <control type="group">
            <left>620</left>
            <include>Anim_SlideLeft</include>
            <control type="label">
                <left>0</left>
                <top>150</top>
                <width>1200</width>
                <height>60</height>
                <font>font37</font>
                <textcolor>text</textcolor>
                <label>$INFO[Control.GetLabel(2)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>208</top>
                <width>1200</width>
                <height>36</height>
                <font>font10</font>
                <textcolor>text3</textcolor>
                <label>$VAR[LucentSettingsSub]</label>
            </control>
            <control type="image">
                <left>0</left>
                <top>254</top>
                <width>48</width>
                <height>5</height>
                <texture border="2">white.png</texture>
                <colordiffuse>focus</colordiffuse>
            </control>
            <control type="grouplist" id="5">
                <onright condition="Control.IsVisible(60)">60</onright>
                <onright>5</onright>
                <left>0</left>
                <top>290</top>
                <width>1200</width>
                <height>640</height>
                <itemgap>10</itemgap>
                <pagecontrol>60</pagecontrol>
                <onleft>3</onleft>
                <onup>5</onup>
                <ondown>5</ondown>
            </control>
            <control type="scrollbar" id="60">
                <left>1222</left>
                <top>290</top>
                <height>640</height>
                <onleft>5</onleft>
            </control>
            <include content="SettingDescription">
                <param name="left">0</param>
                <param name="top">950</param>
                <param name="width">1200</param>
            </include>
        </control>

        <include content="SettingTemplates"><param name="width">1200</param><param name="cpos">1110</param></include>
    </controls>
</window>
