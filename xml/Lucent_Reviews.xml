<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent 2.1.30: the reviews screen (scripts/reviews.py), opened with OK on a card of the Reviews tab of the info page.
     Left: poster, title, average score and number of reviews. Right: TMDB / Trakt (101 / 102), Without spoilers (103)
     and the reviews (200). OK on a review shows the whole text; a spoiler stays hidden until OK. -->
<window type="dialog">
    <defaultcontrol always="true">200</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>white.png</texture><colordiffuse>bg</colordiffuse>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Window.Property(fanart)]</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>white.png</texture><colordiffuse>D10B1119</colordiffuse>
        </control>

        <!-- left: the title -->
        <control type="image">
            <left>96</left><top>96</top><width>400</width><height>600</height>
            <texture border="20" colordiffuse="glass_strong">rr20.png</texture>
        </control>
        <control type="image">
            <left>96</left><top>96</top><width>400</width><height>600</height>
            <aspectratio>scale</aspectratio>
            <texture diffuse="mask_poster.png" background="true">$INFO[Window.Property(poster)]</texture>
        </control>
        <control type="textbox">
            <left>96</left><top>724</top><width>400</width><height>104</height>
            <font>font_heading</font><textcolor>text</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>
        <control type="label">
            <left>96</left><top>832</top><width>400</width><height>34</height>
            <font>font_body</font><textcolor>text3</textcolor>
            <label>$INFO[Window.Property(sub)]</label>
        </control>
        <control type="grouplist">
            <left>96</left><top>884</top><width>400</width><height>100</height>
            <orientation>vertical</orientation><itemgap>12</itemgap>
            <include content="InfoPill">
                <param name="label">$INFO[Window.Property(avg)]</param>
                <param name="visible">!String.IsEmpty(Window.Property(avg))</param>
            </include>
            <include content="InfoPill">
                <param name="label">$INFO[Window.Property(count)]</param>
            </include>
        </control>

        <!-- right: sources, spoiler switch, the reviews -->
        <control type="label">
            <left>580</left><top>92</top><width>800</width><height>34</height>
            <font>font_caps</font><textcolor>text4</textcolor>
            <label>$INFO[Window.Property(kicker)]</label>
        </control>
        <control type="grouplist" id="9001">
            <left>580</left><top>138</top><width>1244</width><height>58</height>
            <orientation>horizontal</orientation><itemgap>10</itemgap>
            <ondown>200</ondown>
            <control type="button" id="101">
                <width>auto</width><height>58</height><font>font_label_bold</font>
                <textoffsetx>26</textoffsetx><align>center</align><aligny>center</aligny>
                <textcolor>text3</textcolor><focusedcolor>on_focus</focusedcolor>
                <texturefocus border="29" colordiffuse="focus">pill60.png</texturefocus>
                <texturenofocus border="29" colordiffuse="$VAR[LucentReviewTabTMDB]">pill60.png</texturenofocus>
                <label>$INFO[Window.Property(tab_tmdb)]</label>
                <visible>!String.IsEmpty(Window.Property(tab_tmdb))</visible>
            </control>
            <control type="button" id="102">
                <width>auto</width><height>58</height><font>font_label_bold</font>
                <textoffsetx>26</textoffsetx><align>center</align><aligny>center</aligny>
                <textcolor>text3</textcolor><focusedcolor>on_focus</focusedcolor>
                <texturefocus border="29" colordiffuse="focus">pill60.png</texturefocus>
                <texturenofocus border="29" colordiffuse="$VAR[LucentReviewTabTrakt]">pill60.png</texturenofocus>
                <label>$INFO[Window.Property(tab_trakt)]</label>
                <visible>!String.IsEmpty(Window.Property(tab_trakt))</visible>
            </control>
            <control type="radiobutton" id="103">
                <width>360</width><height>58</height><font>font_label_bold</font>
                <textoffsetx>26</textoffsetx><aligny>center</aligny>
                <textcolor>text3</textcolor><focusedcolor>on_focus</focusedcolor>
                <texturefocus border="29" colordiffuse="focus">pill60.png</texturefocus>
                <texturenofocus border="29" colordiffuse="1AFFFFFF">pill60.png</texturenofocus>
                <label>$INFO[Window.Property(nospoil_label)]</label>
                <selected>!String.IsEmpty(Window.Property(nospoil))</selected>
                <visible>!String.IsEmpty(Window.Property(has_spoilers))</visible>
            </control>
        </control>
        <control type="list" id="200">
            <left>580</left><top>222</top><width>1244</width><height>820</height>
            <orientation>vertical</orientation>
            <onup>9001</onup>
            <scrolltime tween="cubic" easing="out">220</scrolltime>
            <itemlayout width="1244" height="206">
                <control type="image">
                    <left>0</left><top>0</top><width>1244</width><height>188</height>
                    <texture border="20" colordiffuse="14FFFFFF">rr20.png</texture>
                </control>
                <include content="LucentReviewCard"/>
            </itemlayout>
            <focusedlayout width="1244" height="206">
                <control type="image">
                    <left>0</left><top>0</top><width>1244</width><height>188</height>
                    <texture border="20" colordiffuse="29FFFFFF">rr20.png</texture>
                </control>
                <control type="image">
                    <left>-3</left><top>-3</top><width>1250</width><height>194</height>
                    <texture border="22">rr20_edge.png</texture><colordiffuse>text</colordiffuse>
                    <visible>Control.HasFocus(200)</visible>
                </control>
                <include content="LucentReviewCard"/>
                <control type="label">
                    <left>30</left><top>150</top><width>900</width><height>28</height>
                    <font>font10</font><textcolor>text4</textcolor>
                    <label>$INFO[ListItem.Property(hint)]</label>
                    <visible>Control.HasFocus(200)</visible>
                </control>
            </focusedlayout>
        </control>
        <control type="label">
            <left>580</left><top>240</top><width>1244</width><height>40</height>
            <font>font_body</font><textcolor>text3</textcolor>
            <label>$INFO[Window.Property(empty)]</label>
            <visible>Integer.IsEqual(Container(200).NumItems,0)</visible>
        </control>
    </controls>
</window>
