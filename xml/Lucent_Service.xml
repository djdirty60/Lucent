<?xml version="1.0" encoding="UTF-8"?>
<!-- Lucent: one streaming service in a pop-up (scripts/service.py). Six lists under each other (801-806), filled by
     Lucent Library from TMDb; above them the title under the cursor. Up / down: another list, OK: the title's page. -->
<window>
    <defaultcontrol always="true">801</defaultcontrol>
    <include>Anim_Dialog</include>
    <controls>
        <include>DialogDim</include>
        <control type="group">
            <left>120</left>
            <top>60</top>
            <include content="GlassPanel"><param name="left">0</param><param name="top">0</param><param name="width">1680</param><param name="height">960</param><param name="body">modal</param></include>
            <!-- header: the service's own logo (transparent) or its name -->
            <control type="image">
                <left>48</left><top>30</top><width>420</width><height>90</height>
                <aspectratio align="left">keep</aspectratio>
                <texture background="true">$INFO[Window.Property(svc.logo)]</texture>
                <visible>!String.IsEmpty(Window.Property(svc.logo))</visible>
            </control>
            <control type="label">
                <left>48</left><top>30</top><width>1000</width><height>70</height>
                <font>font45_title</font><textcolor>text</textcolor>
                <label>$INFO[Window.Property(svc.name)]</label>
                <visible>String.IsEmpty(Window.Property(svc.logo))</visible>
            </control>
            <control type="label">
                <left>500</left><top>58</top><width>1132</width><height>36</height>
                <font>font12</font><textcolor>text3</textcolor><align>right</align>
                <label>$INFO[Window.Property(svc.sub)]</label>
            </control>
            <!-- the title under the cursor -->
            <control type="image">
                <left>1112</left><top>136</top><width>520</width><height>170</height>
                <aspectratio scalediffuse="false">scale</aspectratio>
                <texture diffuse="mask_landscape.png" background="true">$VAR[SvcFanart]</texture>
            </control>
            <control type="label">
                <left>48</left><top>140</top><width>1030</width><height>52</height>
                <font>font37_title</font><textcolor>text</textcolor>
                <label>$VAR[SvcTitle]</label>
