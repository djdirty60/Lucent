                        <left>0</left><top>0</top><width>1500</width><height>36</height>
                        <font>font13_bold</font><textcolor>text</textcolor>
                        <label>$INFO[Window.Property(row.1.label)]</label>
                    </control>
                    <control type="list" id="801">
                        <left>-8</left><top>44</top><width>1600</width><height>248</height>
                        <orientation>horizontal</orientation>
                        <onup>801</onup><ondown>802</ondown><onleft>noop</onleft><onright>noop</onright>
                        <scrolltime tween="cubic" easing="out">200</scrolltime>
                        <itemlayout width="170" height="248">
                            <control type="image">
                                <left>8</left><top>4</top><width>150</width><height>225</height>
                                <texture diffuse="mask_poster.png">default_poster.png</texture>
                            </control>
                            <control type="image">
                                <left>8</left><top>4</top><width>150</width><height>225</height>
                                <aspectratio scalediffuse="false">scale</aspectratio>
                                <texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Art(poster)]</texture>
                            </control>
                        </itemlayout>
                        <focusedlayout width="170" height="248">
                            <control type="image">
                                <left>2</left><top>-2</top><width>162</width><height>237</height>
                                <texture border="14">rr14.png</texture>
                                <colordiffuse>FFFFFFFF</colordiffuse>
                                <visible>Control.HasFocus(801)</visible>
                            </control>
