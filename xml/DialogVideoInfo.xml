<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <include>Anim_Window</include>
    <controls>
        <include content="Backdrop">
            <param name="fanart">$VAR[ItemFanart]</param>
        </include>
        <control type="group">
            <include>Anim_SlideLeft</include>
            <control type="image">
                <left>96</left>
                <top>96</top>
                <width>680</width>
                <height>230</height>
                <aspectratio align="left" aligny="bottom">keep</aspectratio>
                <texture background="true">$VAR[ItemLogo]</texture>
            </control>
            <control type="textbox">
                <left>96</left>
                <top>96</top>
                <width>1200</width>
                <height>230</height>
                <font>font60</font>
                <aligny>bottom</aligny>
                <label>$VAR[ItemTitle]</label>
                <visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
            </control>
            <control type="grouplist">
                <left>96</left>
                <top>352</top>
                <width>1400</width>
                <height>44</height>
                <orientation>horizontal</orientation>
                <itemgap>12</itemgap>
                <include content="InfoPill">
                    <param name="label">$VAR[ItemSE]</param>
                    <param name="bg">glass_strong</param>
                    <param name="color">text</param>
                    <param name="visible">!String.IsEmpty(ListItem.Season) + [String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)]</param>
                </include>
                <include content="InfoPill">
                    <param name="label">$INFO[ListItem.Year]</param>
                    <param name="visible">!String.IsEmpty(ListItem.Year)</param>
                </include>
                <include content="InfoPill">
                    <param name="label">$VAR[ItemRating]</param>
                    <param name="visible">!String.IsEmpty(ListItem.Rating)</param>
                </include>
                <include content="InfoPill">
                    <param name="label">$VAR[ItemDuration]</param>
                    <param name="visible">Integer.IsGreater(ListItem.Duration(mins),0)</param>
                </include>
                <include content="InfoPill">
                    <param name="label">$INFO[ListItem.MPAA]</param>
                    <param name="visible">!String.IsEmpty(ListItem.MPAA)</param>
                </include>
                <include content="InfoPill">
                    <param name="label">$INFO[ListItem.VideoResolution]$INFO[ListItem.VideoCodec,  ·  ,]</param>
                    <param name="visible">!String.IsEmpty(ListItem.VideoResolution)</param>
                </include>
                <control type="label">
                    <width>auto</width>
                    <height>44</height>
                    <font>font12</font>
                    <textcolor>text3</textcolor>
                    <label>$INFO[ListItem.Genre]</label>
                </control>
            </control>
            <control type="label">
                <left>96</left>
                <top>414</top>
                <width>1200</width>
                <height>48</height>
                <font>font32</font>
                <label>$INFO[ListItem.Title]</label>
                <visible>String.IsEqual(ListItem.DBType,episode)</visible>
            </control>
            <control type="textbox" id="4">
                <left>96</left>
                <top>470</top>
                <width>1000</width>
                <height>170</height>
                <font>font_plot</font>
                <textcolor>text2</textcolor>
                <label>$INFO[ListItem.Plot]</label>
                <autoscroll delay="8000" time="3000" repeat="10000">true</autoscroll>
            </control>
            <control type="label">
                <left>96</left>
                <top>650</top>
                <width>1300</width>
                <height>36</height>
                <font>font10</font>
                <textcolor>text4</textcolor>
                <label>$INFO[ListItem.Director,$LOCALIZE[31078] ,]$INFO[ListItem.Studio,   ·   ,]$INFO[ListItem.Premiered,   ·   ,]</label>
            </control>

            <!-- Actions -->
            <control type="grouplist" id="9000">
                <left>96</left>
                <top>712</top>
                <width>1728</width>
                <height>64</height>
                <orientation>horizontal</orientation>
                <itemgap>14</itemgap>
                <ondown>50</ondown>
                <control type="button" id="8">
                    <width>auto</width>
                    <height>64</height>
                    <label>▶  $LOCALIZE[208]</label>
                    <visible>true</visible>
                </control>
                <control type="button" id="9">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[31018]</label>
                    <visible>ListItem.IsResumable</visible>
                </control>
                <control type="button" id="5">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[31021]</label>
                    <visible>true</visible>
                </control>
                <control type="button" id="11">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[20410]</label>
                    <visible>!String.IsEmpty(ListItem.Trailer)</visible>
                </control>
                <control type="button" id="14">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[40000]</label>
                    <visible>ListItem.HasVideoVersions</visible>
                </control>
                <control type="button" id="15">
                    <width>auto</width>
                    <height>64</height>
                    <label>Extras</label>
                    <visible>ListItem.HasVideoExtras</visible>
                </control>
                <control type="button" id="7">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[31063]</label>
                    <visible>!String.IsEmpty(ListItem.DBID)</visible>
                </control>
                <control type="button" id="6">
                    <width>auto</width>
                    <height>64</height>
                    <label>$LOCALIZE[184]</label>
                    <visible>!String.IsEmpty(ListItem.DBID)</visible>
                </control>
            </control>
        </control>

        <!-- Cast row (Kodi swaps it with the plot via button 5) -->
        <control type="group">
            <include>Anim_SlideUp</include>
            <control type="label">
                <visible>Control.IsVisible(50)</visible>
                <left>96</left>
                <top>808</top>
                <width>800</width>
                <height>44</height>
                <font>font_mainmenu_small</font>
                <label>$LOCALIZE[31021]</label>
            </control>
            <control type="fixedlist" id="50">
                <left>72</left>
                <top>846</top>
                <width>1848</width>
                <height>234</height>
                <orientation>horizontal</orientation>
                <focusposition>0</focusposition>
                <onup>9000</onup>
                <itemlayout width="196" height="230">
                    <control type="image">
                        <left>24</left>
                        <top>14</top>
                        <width>148</width>
                        <height>148</height>
                        <aspectratio>scale</aspectratio>
                        <texture diffuse="mask_circle.png" fallback="default_poster.png">$INFO[ListItem.Art(thumb)]</texture>
                    </control>
                    <control type="label">
                        <left>8</left>
                        <top>170</top>
                        <width>180</width>
                        <height>30</height>
                        <font>font10</font>
                        <align>center</align>
                        <textcolor>text2</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>8</left>
                        <top>198</top>
                        <width>180</width>
                        <height>28</height>
                        <font>font_tiny</font>
                        <align>center</align>
                        <textcolor>text4</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="196" height="230">
                    <control type="group">
                        <left>24</left>
                        <top>14</top>
                        <animation effect="zoom" start="100" end="106" center="auto" time="200" tween="cubic" easing="out">Focus</animation>
                        <control type="image">
                            <left>0</left>
                            <top>0</top>
                            <width>148</width>
                            <height>148</height>
                            <aspectratio>scale</aspectratio>
                            <texture diffuse="mask_circle.png" fallback="default_poster.png">$INFO[ListItem.Art(thumb)]</texture>
                        </control>
                        <control type="image">
                            <left>-4</left>
                            <top>-4</top>
                            <width>156</width>
                            <height>156</height>
                            <texture>mask_circle.png</texture>
                            <colordiffuse>40FFFFFF</colordiffuse>
                            <visible>Control.HasFocus(50)</visible>
                        </control>
                    </control>
                    <control type="label">
                        <left>8</left>
                        <top>170</top>
                        <width>180</width>
                        <height>30</height>
                        <font>font10_bold</font>
                        <align>center</align>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>8</left>
                        <top>198</top>
                        <width>180</width>
                        <height>28</height>
                        <font>font_tiny</font>
                        <align>center</align>
                        <textcolor>text3</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
        <include>Clock</include>
    </controls>
</window>
