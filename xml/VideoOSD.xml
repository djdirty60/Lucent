<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <onload condition="!Player.Paused">SetFocus(103)</onload>
    <onload condition="Player.Paused">SetFocus(104)</onload>
    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>360</height>
            <texture>grad_top.png</texture>
            <colordiffuse>E6000000</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>560</top>
            <width>1920</width>
            <height>520</height>
            <texture>grad_bottom.png</texture>
            <colordiffuse>F2000000</colordiffuse>
        </control>
        <control type="group">
            <animation effect="slide" start="0,-40" end="0,0" time="300" tween="cubic" easing="out">WindowOpen</animation>
        <!-- Logo / title -->
        <control type="group">
            <left>96</left>
            <top>56</top>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>440</width>
                <height>150</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <texture background="true">$VAR[PlayerLogo]</texture>
            </control>
            <control type="label">
                <left>0</left>
                <top>40</top>
                <width>1300</width>
                <height>70</height>
                <font>font45</font>
                <label>$VAR[PlayerTitle]</label>
                <visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>160</top>
                <width>1300</width>
                <height>40</height>
                <font>font13_bold</font>
                <textcolor>text2</textcolor>
                <label>$VAR[PlayerSubtitle]</label>
            </control>
        </control>
        <control type="label">
            <right>96</right>
            <top>56</top>
            <width>500</width>
            <height>44</height>
            <align>right</align>
            <font>font_clock</font>
            <label>$INFO[System.Time]</label>
        </control>
        <control type="label">
            <right>96</right>
            <top>100</top>
            <width>500</width>
            <height>36</height>
            <align>right</align>
            <font>font10</font>
            <textcolor>text3</textcolor>
            <label>$LOCALIZE[31047] $INFO[Player.FinishTime]</label>
            <visible>Player.HasDuration</visible>
        </control>
        </control>
        <control type="group">
            <animation effect="slide" start="0,60" end="0,0" time="320" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="0,60" time="220" tween="cubic" easing="in">WindowClose</animation>
        <control type="group">
            <left>96</left>
            <top>892</top>
            <width>1728</width>
            <control type="label">
                <left>0</left>
                <top>-56</top>
                <width>400</width>
                <height>40</height>
                <font>font13_bold</font>
                <label>$INFO[Player.Time]</label>
            </control>
            <control type="label">
                <right>0</right>
                <top>-56</top>
                <width>600</width>
                <height>40</height>
                <align>right</align>
                <font>font13</font>
                <textcolor>text3</textcolor>
                <label>-$INFO[Player.TimeRemaining]   /   $INFO[Player.Duration]</label>
            </control>
            <control type="progress">
                <left>0</left>
                <top>0</top>
                <width>1728</width>
                <height>6</height>
                <info>Player.ProgressCache</info>
                <texturebg border="3" colordiffuse="26FFFFFF">pill6.png</texturebg>
                <midtexture border="3" colordiffuse="40FFFFFF">pill6.png</midtexture>
            </control>
            <control type="progress">
                <left>0</left>
                <top>0</top>
                <width>1728</width>
                <height>6</height>
                <info>Player.Progress</info>
                <texturebg/>
                <midtexture border="3" colordiffuse="text">pill6.png</midtexture>
            </control>
            <control type="slider" id="87">
                <left>0</left>
                <top>-10</top>
                <width>1728</width>
                <height>26</height>
                <action>seek</action>
                <info>Player.Progress</info>
                <texturesliderbar colordiffuse="00FFFFFF">slider_bar26.png</texturesliderbar>
                <textureslidernib colordiffuse="00FFFFFF">nib26.png</textureslidernib>
                <textureslidernibfocus colordiffuse="text">nib26.png</textureslidernibfocus>
                <ondown>100</ondown>
                <onup>noop</onup>
                <visible>Player.SeekEnabled</visible>
            </control>
        </control>
            <control type="grouplist" id="100">
                <left>96</left>
                <top>936</top>
                <width>1728</width>
                <height>104</height>
                <orientation>horizontal</orientation>
                <align>center</align>
                <itemgap>22</itemgap>
                <onup>87</onup>
                <usecontrolcoords>false</usecontrolcoords>
            <control type="button" id="101">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/prev_fo.png</texturefocus>
                <texturenofocus>buttons/prev_nf.png</texturenofocus>
                <onclick>PlayerControl(Previous)</onclick>
                <visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1)</visible>
            </control>
            <control type="button" id="102">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/rewind_fo.png</texturefocus>
                <texturenofocus>buttons/rewind_nf.png</texturenofocus>
                <onclick>Seek(-10)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="103">
                <width>104</width>
                <height>104</height>
                <label></label>
                <texturefocus>buttons/pause_fo.png</texturefocus>
                <texturenofocus>buttons/pause_nf.png</texturenofocus>
                <onclick>PlayerControl(Play)</onclick>
                <visible>!Player.Paused</visible>
            </control>
            <control type="button" id="104">
                <width>104</width>
                <height>104</height>
                <label></label>
                <texturefocus>buttons/play_fo.png</texturefocus>
                <texturenofocus>buttons/play_nf.png</texturenofocus>
                <onclick>PlayerControl(Play)</onclick>
                <visible>Player.Paused</visible>
            </control>
            <control type="button" id="105">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/forward_fo.png</texturefocus>
                <texturenofocus>buttons/forward_nf.png</texturenofocus>
                <onclick>Seek(30)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="106">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/next_fo.png</texturefocus>
                <texturenofocus>buttons/next_nf.png</texturenofocus>
                <onclick>PlayerControl(Next)</onclick>
                <visible>Player.ChapterCount | Integer.IsGreater(Playlist.Length(video),1)</visible>
            </control>
            <control type="label">
                <width>120</width>
                <height>84</height>
                <label></label>
            </control>
            <control type="button" id="111">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/subtitles_fo.png</texturefocus>
                <texturenofocus>buttons/subtitles_nf.png</texturenofocus>
                <onclick>ActivateWindow(osdsubtitlesettings)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="112">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/audio_fo.png</texturefocus>
                <texturenofocus>buttons/audio_nf.png</texturenofocus>
                <onclick>ActivateWindow(osdaudiosettings)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="113">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/videosettings_fo.png</texturefocus>
                <texturenofocus>buttons/videosettings_nf.png</texturenofocus>
                <onclick>ActivateWindow(osdvideosettings)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="114">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/bookmark_fo.png</texturefocus>
                <texturenofocus>buttons/bookmark_nf.png</texturenofocus>
                <onclick>ActivateWindow(videobookmarks)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="115">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/info_fo.png</texturefocus>
                <texturenofocus>buttons/info_nf.png</texturenofocus>
                <onclick>ActivateWindow(playerprocessinfo)</onclick>
                <visible>true</visible>
            </control>
            <control type="button" id="116">
                <width>84</width>
                <height>84</height>
                <label></label>
                <texturefocus>buttons/stop_fo.png</texturefocus>
                <texturenofocus>buttons/stop_nf.png</texturenofocus>
                <onclick>PlayerControl(Stop)</onclick>
                <visible>true</visible>
            </control>
            </control>
            <!-- Focused button name -->
            <control type="label">
                <left>96</left>
                <top>1040</top>
                <width>1728</width>
                <height>34</height>
                <align>center</align>
                <font>font10</font>
                <textcolor>text3</textcolor>
                <label>$VAR[OSDButtonLabel]</label>
            </control>
        </control>
    </controls>
</window>
