    <!-- Templates Kodi clones for every setting row (ids 7-15 are fixed by Kodi) -->
    <include name="SettingTemplates">
        <param name="width">1180</param>
        <param name="cpos">1090</param>
        <definition>
            <control type="button" id="7">
                <width>$PARAM[width]</width>
                <height>76</height>
