<?xml version="1.0" encoding="UTF-8"?>
<window>
    <depth>DepthMax</depth>
    <!-- 3.0.18 (#39): only a short fade, no slide: Kodi does not count the open animation as display time, so quick
         audio switches (long press) piled up behind it -->
    <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
    <controls>
        <control type="group">
            <left>1200</left>
            <top>48</top>
            <include content="GlassPanel">
                <param name="left">0</param>
                <param name="top">0</param>
                <param name="width">672</param>
                <param name="height">132</param>
                <param name="body">modal</param>
            </include>
            <control type="image" id="400">
                <left>28</left>
                <top>30</top>
                <width>72</width>
                <height>72</height>
                <aspectratio>keep</aspectratio>
            </control>
            <control type="label" id="401">
                <left>124</left>
                <top>22</top>
                <width>520</width>
                <height>44</height>
                <font>font13_bold</font>
            </control>
            <!-- 3.0.18 (#39): a plain label, as in Nimbus - Kodi holds every queued notification until a fadelabel has
                 scrolled to its end, so the audio box lagged behind and went on after playback had stopped -->
            <control type="label" id="402">
                <left>124</left>
                <top>66</top>
                <width>520</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>text3</textcolor>
            </control>
        </control>
    </controls>
</window>
